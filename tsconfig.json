{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "*": [
        "node_modules/*",
        "node_modules/obsidian"
      ]
    },
    "typeRoots": [
      "node_modules/@types",
      "node_modules/obsidian"
    ],
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es6",
    "allowJs": false,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts"
, "main.ts"  ]
}
